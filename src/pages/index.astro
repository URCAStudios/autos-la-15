---
import { sanityClient } from 'sanity:client';
import fallbackHero from '../../assets/hero-image-large.jpg';
import fallbackHistory from '../../assets/who-are-we-image.jpg';
import { createSanityImageBuilder, type SanityImage } from '../lib/sanityImage';
import '../styles/global.css';

type Link = { label?: string; href?: string; openInNewTab?: boolean };
type SectionIntro = { eyebrow?: string; title?: string; lead?: string };
type StatItem = { value?: number; suffix?: string; label?: string };
type Testimonial = { quote?: string; author?: string; dateLabel?: string; rating?: number };
type FaqItem = { question?: string; answerParagraphs?: string[]; defaultOpen?: boolean };
type ContactCard = {
  number?: string;
  title?: string;
  body?: string;
  linkLabel?: string;
  linkHref?: string;
  showHours?: boolean;
  showContactChannels?: boolean;
};

type Car = {
  _id: string;
  _createdAt?: string;
  name: string;
  title?: string;
  year: number;
  price: number;
  description?: string;
  image?: SanityImage;
  images?: SanityImage[];
  status: 'available' | 'reserved';
  featured?: boolean;
  order?: number;
  badge?: string;
  whatsappMessage?: string;
};

type Location = { city?: string; address?: string; mapUrl?: string };
type Hour = { label?: string; opening?: string; closing?: string };

type SiteSettings = {
  identity?: { brandName?: string; tagline?: string; logo?: SanityImage };
  contact?: { phone?: string; whatsapp?: string; email?: string };
  hours?: Hour[];
  locations?: Location[];
  socialLinks?: { instagram?: string; facebook?: string; tiktok?: string };
  navigation?: { mainLinks?: Link[]; whatsappButtonLabel?: string };
  footer?: {
    links?: Link[];
    whatsappActionLabel?: string;
    instagramActionLabel?: string;
    copyright?: string;
  };
  messaging?: { defaultWhatsappMessage?: string; whatsappFabLabel?: string };
  seo?: { metaDescription?: string };
};

type HomePage = {
  hero?: {
    image?: SanityImage;
    intro?: SectionIntro;
    primaryCta?: Link;
    secondaryCta?: Link;
    scrollHint?: string;
  };
  stats?: { intro?: SectionIntro; items?: StatItem[] };
  history?: { image?: SanityImage; eyebrow?: string; title?: string; paragraphs?: string[] };
  catalog?: {
    intro?: SectionIntro;
    emptyMessage?: string;
    note?: string;
    noteLinkLabel?: string;
    noteLinkHref?: string;
    vehiclePrimaryButton?: string;
    vehicleSecondaryButton?: string;
  };
  testimonials?: { intro?: SectionIntro; featured?: Testimonial; supporting?: Testimonial[] };
  faq?: { intro?: SectionIntro; sidebarLink?: Link; items?: FaqItem[] };
  contact?: {
    title?: string;
    eyebrow?: string;
    lead?: string;
    cards?: ContactCard[];
    locationHeading?: string;
    whatsappCtaLabel?: string;
    instagramHandle?: string;
  };
};

const imageFields = `"asset": asset, alt, crop, hotspot`;

const [siteSettings, homePage, cars] = await Promise.all([
  sanityClient.fetch<SiteSettings | null>(`*[_type == "siteSettings"][0]{
    identity{ brandName, tagline, logo{..., ${imageFields}} },
    contact, hours, locations, socialLinks,
    navigation, footer, messaging, seo
  }`),
  sanityClient.fetch<HomePage | null>(`*[_type == "homePage"][0]{
    hero{ image{..., ${imageFields}}, intro, primaryCta, secondaryCta, scrollHint },
    stats{ intro, items[]{ value, suffix, label } },
    history{ image{..., ${imageFields}}, eyebrow, title, paragraphs },
    catalog{ intro, emptyMessage, note, noteLinkLabel, noteLinkHref, vehiclePrimaryButton, vehicleSecondaryButton },
    testimonials{ intro, featured, supporting[]{ quote, author, dateLabel, rating } },
    faq{ intro, sidebarLink, items[]{ question, answerParagraphs, defaultOpen } },
    contact
  }`),
  sanityClient.fetch<Car[]>(`*[_type == "car" && status in ["available", "reserved"]]
    | order(coalesce(order, 9999) asc, featured desc, _createdAt asc, _id asc){
      _id, _createdAt, name, title, year, price, description,
      image{..., ${imageFields}},
      images[]{..., ${imageFields}},
      status, featured, order, badge, whatsappMessage
    }`),
]);

const settings = siteSettings ?? {};
const home = homePage ?? {};

const config = sanityClient.config();
if (!config.projectId || !config.dataset) throw new Error('Sanity project configuration is required to build image URLs.');
const images = createSanityImageBuilder(config.projectId, config.dataset);

const brandName = settings.identity?.brandName ?? 'AUTOS LA 15';
const tagline = settings.identity?.tagline ?? 'Compra con claridad. Vende con confianza.';
const contact = settings.contact ?? {};
const locations = settings.locations ?? [];
const hours = settings.hours ?? [];
const firstLocation = locations[0];
const whatsappNumber = (contact.whatsapp || contact.phone || '').replace(/[^\d]/g, '');
const generalMessage = settings.messaging?.defaultWhatsappMessage ?? 'Hola AUTOS LA 15, quiero más información';
const whatsappHref = (message: string) =>
  whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}` : '#contacto';

const resolveHref = (link?: Link) => {
  const href = link?.href?.trim();
  if (!href || href === 'whatsapp') return whatsappHref(generalMessage);
  return href;
};

const linkTarget = (link?: Link) => (link?.openInNewTab ? '_blank' : undefined);
const linkRel = (link?: Link) => (link?.openInNewTab ? 'noopener' : undefined);

const fillTemplate = (template: string, vars: Record<string, string>) =>
  template.replace(/\{(\w+)\}/g, (_, key: string) => vars[key] ?? '');

const heroIntro = home.hero?.intro ?? {};
const metaDescription =
  settings.seo?.metaDescription?.trim() || heroIntro.lead || 'Autos La 15 — vehículos en Maracaibo y Ciudad Ojeda.';

const logoSrc = images.url(settings.identity?.logo, { width: 128, height: 128, fit: 'crop' }) || '/assets/img/logo.png';
const logoAlt = settings.identity?.logo?.alt ?? `Logo de ${brandName}`;
const heroSrc = images.url(home.hero?.image, { width: 2400 }) || fallbackHero.src;
const heroAlt = home.hero?.image?.alt ?? 'Fachada de Autos La 15';
const historySrc = images.url(home.history?.image, { width: 1600 }) || fallbackHistory.src;
const historyAlt = home.history?.image?.alt ?? 'Fachada de Autos La 15';

const cardImageUrl = (image: SanityImage | undefined) =>
  images.url(image, { width: 1800, height: 1100, fit: 'crop' });

const vehicleImages = (car: Car): SanityImage[] => {
  if (car.images?.length) return car.images;
  return car.image ? [car.image] : [];
};

const isZeroKm = (car: Car) => /0\s*km/i.test(car.badge ?? '');
const catalogFilterTags = (car: Car) => {
  const tags: string[] = [];
  if (car.status === 'reserved') tags.push('reserved');
  if (isZeroKm(car)) tags.push('zero-km');
  if (car.status === 'available' && !isZeroKm(car)) tags.push('used');
  return tags.join(' ');
};
const formatPrice = (price: number) =>
  new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(price);

const navLinks = settings.navigation?.mainLinks ?? [];
const footerLinks = settings.footer?.links ?? [];
const statsItems = home.stats?.items ?? [];
const faqItems = home.faq?.items ?? [];
const testimonialSupporting = home.testimonials?.supporting ?? [];
const contactCards = home.contact?.cards ?? [];
const catalog = home.catalog ?? {};

const mapSrc = firstLocation?.mapUrl
  ? `${firstLocation.mapUrl}${firstLocation.mapUrl.includes('?') ? '&' : '?'}z=17&output=embed`
  : '';

const siteUrl = import.meta.env.PUBLIC_SITE_URL?.trim();
const canonicalUrl = siteUrl ? new URL('/', siteUrl).toString() : undefined;
const heroOgUrl = siteUrl ? new URL(heroSrc, siteUrl).toString() : heroSrc;
const siteIconPath = '/assets/img/logo.png';
const siteIconUrl = canonicalUrl ? new URL(siteIconPath, canonicalUrl).toString() : siteIconPath;

const copyrightText = fillTemplate(settings.footer?.copyright ?? '© {year} {brand}. Todos los derechos reservados.', {
  year: String(new Date().getFullYear()),
  brand: brandName,
});

const whatsappFabLabel = fillTemplate(settings.messaging?.whatsappFabLabel ?? 'Hablar con {brand} por WhatsApp', {
  brand: brandName,
});

const starsFor = (rating = 5) => '★'.repeat(Math.min(5, Math.max(1, rating)));

const contactTitleLines = (home.contact?.title ?? '').split('\n').filter(Boolean);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  name: brandName,
  description: metaDescription,
  telephone: contact.phone,
  email: contact.email,
  ...(siteUrl ? { url: siteUrl } : {}),
  ...(siteIconUrl
    ? {
        logo: { '@type': 'ImageObject', url: siteIconUrl },
        image: siteIconUrl,
      }
    : {}),
  areaServed: locations.map((location) => location.city).filter(Boolean),
  address: firstLocation?.address
    ? { '@type': 'PostalAddress', addressLocality: firstLocation.city, streetAddress: firstLocation.address, addressCountry: 'VE' }
    : undefined,
  sameAs: [settings.socialLinks?.instagram, settings.socialLinks?.facebook, settings.socialLinks?.tiktok].filter(Boolean),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={`${brandName} | ${tagline}`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={heroOgUrl} />
    {canonicalUrl && (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:site_name" content={brandName} />
        <meta property="og:locale" content="es_VE" />
        <link rel="alternate" hreflang="es-ve" href={canonicalUrl} />
        <link rel="alternate" hreflang="es" href={canonicalUrl} />
        <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href={siteIconPath} sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{brandName} | {tagline}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>

    <header class="site-header over-hero">
      <div class="container header-inner">
        <a href="#top" class="brand" aria-label={`${brandName}, inicio`}>
          <img src={logoSrc} alt={logoAlt} class="brand-logo" width="40" height="40" />
          <span class="brand-text"><strong>{brandName}</strong><small>{tagline}</small></span>
        </a>
        <nav class="main-nav" id="main-nav" aria-label="Navegación principal">
          {navLinks.map((link) => (
            <a href={resolveHref(link)}>{link.label}</a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="btn btn-whatsapp" href={whatsappHref(generalMessage)} target="_blank" rel="noopener" aria-label={settings.navigation?.whatsappButtonLabel ?? 'Hablar por WhatsApp'}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.868-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.226 1.36.194 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.5 3.657 1.451 5.24L2 22l4.897-1.416A9.945 9.945 0 0 0 12.001 22C17.523 22 22 17.522 22 12S17.523 2 12.001 2zm0 18.062a8.012 8.012 0 0 1-4.088-1.118l-.293-.175-2.902.839.848-2.827-.19-.29A8.06 8.06 0 0 1 3.938 12c0-4.446 3.617-8.062 8.063-8.062S20.063 7.554 20.063 12 16.447 20.062 12.001 20.062z"/></svg>
            <span>{settings.navigation?.whatsappButtonLabel ?? 'Hablar por WhatsApp'}</span>
          </a>
          <button class="nav-toggle" id="nav-toggle" type="button" aria-label="Abrir navegación" aria-expanded="false" aria-controls="main-nav">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <img class="hero-image" src={heroSrc} alt={heroAlt} width={fallbackHero.width} height={fallbackHero.height} fetchpriority="high" />
        <div class="hero-overlay" aria-hidden="true"></div>
        <div class="container hero-inner">
          <div class="hero-content">
            {heroIntro.eyebrow && <p class="eyebrow reveal">{heroIntro.eyebrow}</p>}
            {heroIntro.title && <h1 id="hero-title" class="reveal">{heroIntro.title}</h1>}
            {heroIntro.lead && <p class="hero-lead reveal">{heroIntro.lead}</p>}
            <div class="hero-actions reveal">
              {home.hero?.primaryCta?.label && (
                <a href={resolveHref(home.hero.primaryCta)} class="btn btn-primary" target={linkTarget(home.hero.primaryCta)} rel={linkRel(home.hero.primaryCta)}>
                  {home.hero.primaryCta.label}
                </a>
              )}
              {home.hero?.secondaryCta?.label && (
                <a href={resolveHref(home.hero.secondaryCta)} class="btn btn-ghost" target={linkTarget(home.hero.secondaryCta) ?? '_blank'} rel={linkRel(home.hero.secondaryCta) ?? 'noopener'}>
                  {home.hero.secondaryCta.label}
                </a>
              )}
            </div>
          </div>
          {home.hero?.scrollHint && (
            <span class="hero-scroll-hint" aria-hidden="true">{home.hero.scrollHint}</span>
          )}
        </div>
      </section>

      {statsItems.length > 0 && (
        <section class="stats reveal" aria-label="Datos de Autos La 15">
          <div class="container">
            <div class="stats-intro">
              {home.stats?.intro?.eyebrow && <p class="section-eyebrow">{home.stats.intro.eyebrow}</p>}
              {home.stats?.intro?.lead && <p>{home.stats.intro.lead}</p>}
            </div>
            <div class="stats-grid">
              {statsItems.map((stat) => (
                <div class="stat">
                  <span class="stat-num" data-count-to={stat.value} data-suffix={stat.suffix ?? ''}>0</span>
                  <span class="stat-label">{stat.label}</span>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="section" id="nosotros" aria-labelledby="history-title">
        <div class="container history-grid">
          <div class="history-media reveal">
            <img src={historySrc} alt={historyAlt} width={fallbackHistory.width} height={fallbackHistory.height} loading="lazy" />
          </div>
          <div class="history-copy">
            {home.history?.eyebrow && <p class="section-eyebrow reveal">{home.history.eyebrow}</p>}
            {home.history?.title && <h2 id="history-title" class="reveal">{home.history.title}</h2>}
            {home.history?.paragraphs?.map((paragraph) => (
              <p class="section-lead reveal">{paragraph}</p>
            ))}
          </div>
        </div>
      </section>

      <section class="section showcase" id="catalogo" aria-labelledby="catalog-title">
        <div class="container">
          {catalog.intro?.eyebrow && <p class="section-eyebrow reveal">{catalog.intro.eyebrow}</p>}
          {catalog.intro?.title && <h2 id="catalog-title" class="reveal">{catalog.intro.title}</h2>}
          {catalog.intro?.lead && <p class="section-lead reveal">{catalog.intro.lead}</p>}
          {cars.length === 0 && catalog.emptyMessage && (
            <p class="section-lead">{catalog.emptyMessage}</p>
          )}
        </div>
        {cars.length > 0 && (
          <div class="slideshow" data-slideshow>
            <div class="container catalog-filters-wrap">
              <div class="catalog-filters" role="toolbar" aria-label="Filtrar vehículos">
                <button class="catalog-filter is-active" type="button" data-catalog-filter="all" aria-pressed="true">Todos</button>
                <button class="catalog-filter" type="button" data-catalog-filter="zero-km" aria-pressed="false">0 KM</button>
                <button class="catalog-filter" type="button" data-catalog-filter="used" aria-pressed="false">Usados</button>
                <button class="catalog-filter" type="button" data-catalog-filter="reserved" aria-pressed="false">Reservados</button>
              </div>
              <div class="catalog-filters-aside">
                <div class="catalog-sort" data-catalog-sort data-value="default">
                  <button
                    class="catalog-sort-trigger"
                    type="button"
                    data-catalog-sort-trigger
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-controls="catalog-sort-list"
                  >
                    <span data-catalog-sort-current>Ordenar</span>
                    <svg class="catalog-sort-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                      <path fill="currentColor" d="M3 4.25 6 7.25 9 4.25" />
                    </svg>
                  </button>
                  <div class="catalog-sort-popover" data-catalog-sort-popover hidden>
                    <ul class="catalog-sort-list" id="catalog-sort-list" role="listbox" aria-label="Ordenar vehículos por año">
                      <li role="presentation">
                        <button class="catalog-sort-option is-selected" type="button" role="option" data-catalog-sort-value="default" aria-selected="true">
                          Ordenar
                          <span class="catalog-sort-check" aria-hidden="true">✓</span>
                        </button>
                      </li>
                      <li role="presentation">
                        <button class="catalog-sort-option" type="button" role="option" data-catalog-sort-value="newest" aria-selected="false">
                          Más nuevos
                          <span class="catalog-sort-check" aria-hidden="true">✓</span>
                        </button>
                      </li>
                      <li role="presentation">
                        <button class="catalog-sort-option" type="button" role="option" data-catalog-sort-value="oldest" aria-selected="false">
                          Más antiguos
                          <span class="catalog-sort-check" aria-hidden="true">✓</span>
                        </button>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
            <div class="container">
              <div class="catalog-filter-empty" data-catalog-filter-empty hidden>
                <p class="catalog-filter-empty-text" data-catalog-filter-empty-text>
                  No hay vehículos que coincidan con este filtro.
                </p>
                <button class="btn btn-primary catalog-filter-empty-reset" type="button" data-catalog-filter-reset>
                  Ver todos los vehículos
                </button>
              </div>
            </div>
            <div class="slideshow-viewport">
              <button class="slideshow-arrow slideshow-arrow-prev" type="button" data-slideshow-prev aria-label="Ver vehículo anterior">
                <span aria-hidden="true">‹</span>
              </button>
              <div class="slideshow-track" data-slideshow-track tabindex="0" aria-label="Presentación de vehículos">
                {cars.map((car, index) => {
                  const photos = vehicleImages(car);
                  const hasGallery = photos.length > 1;
                  return (
                  <article class:list={['vehicle-card', index === 0 && 'is-active']} id={`vehiculo-${car._id}`} data-slideshow-slide data-car-id={car._id} data-catalog-filter={catalogFilterTags(car)} data-sort-index={index} data-sort-year={car.year} data-sort-created={car._createdAt ?? ''} aria-roledescription="diapositiva" aria-label={`${index + 1} de ${cars.length}: ${car.name}`}>
                    <div class="vehicle-card-gallery" data-vehicle-gallery={hasGallery ? '' : undefined}>
                      {photos.map((photo, photoIndex) => (
                        <img
                          class:list={['vehicle-card-image', photoIndex === 0 && 'is-active']}
                          data-vehicle-gallery-image={photoIndex}
                          src={cardImageUrl(photo)}
                          alt={photo.alt ?? car.name}
                          width="1800"
                          height="1100"
                          loading={index === 0 && photoIndex === 0 ? 'eager' : 'lazy'}
                        />
                      ))}
                      {hasGallery && (
                        <>
                          <button class="vehicle-gallery-arrow vehicle-gallery-arrow-prev" type="button" data-vehicle-gallery-prev aria-label={`Foto anterior de ${car.name}`}>
                            <span aria-hidden="true">‹</span>
                          </button>
                          <button class="vehicle-gallery-arrow vehicle-gallery-arrow-next" type="button" data-vehicle-gallery-next aria-label={`Foto siguiente de ${car.name}`}>
                            <span aria-hidden="true">›</span>
                          </button>
                          <div class="vehicle-gallery-meta" aria-live="polite">
                            <div class="vehicle-gallery-dots" role="tablist" aria-label={`Fotos de ${car.name}`}>
                              {photos.map((photo, photoIndex) => (
                                <button
                                  class:list={['vehicle-gallery-dot', photoIndex === 0 && 'is-active']}
                                  type="button"
                                  role="tab"
                                  data-vehicle-gallery-dot={photoIndex}
                                  aria-label={`Foto ${photoIndex + 1}${photo.alt ? `: ${photo.alt}` : ''}`}
                                  aria-selected={photoIndex === 0 ? 'true' : 'false'}
                                ></button>
                              ))}
                            </div>
                            <p class="vehicle-gallery-status" data-vehicle-gallery-status>1 de {photos.length}</p>
                          </div>
                        </>
                      )}
                    </div>
                    {hasGallery && (
                      <div class="vehicle-gallery-progress" aria-hidden="true">
                        <span class="vehicle-gallery-progress-fill" data-vehicle-gallery-progress-fill></span>
                      </div>
                    )}
                    <div class="vehicle-card-shade" aria-hidden="true"></div>
                    <div class="vehicle-card-copy">
                      <div class="vehicle-card-footer">
                        <h3 id={`vehiculo-titulo-${car._id}`}>{car.name}</h3>
                        <p class="vehicle-price">{formatPrice(car.price)}</p>
                        <div class="vehicle-card-actions">
                          <a class="btn vehicle-btn-primary" target="_blank" rel="noopener" href={whatsappHref(car.whatsappMessage ?? `Hola AUTOS LA 15, me interesa el ${car.name}. ¿Me comparten más información?`)}>
                            {catalog.vehiclePrimaryButton ?? 'Consultar vehículo'}
                          </a>
                          <a class="btn vehicle-btn-secondary" href="#contacto">{catalog.vehicleSecondaryButton ?? 'Agendar visita'}</a>
                        </div>
                      </div>
                    </div>
                  </article>
                  );
                })}
              </div>
              <button class="slideshow-arrow slideshow-arrow-next" type="button" data-slideshow-next aria-label="Ver vehículo siguiente">
                <span aria-hidden="true">›</span>
              </button>
            </div>
            <div class="slideshow-meta">
              <div class="slideshow-dots" role="tablist" aria-label="Vehículos de la presentación">
                {cars.map((car, index) => (
                  <button class:list={['slideshow-dot', index === 0 && 'is-active']} type="button" role="tab" data-slideshow-dot data-car-id={car._id} data-catalog-filter={catalogFilterTags(car)} data-sort-index={index} data-sort-year={car.year} data-sort-created={car._createdAt ?? ''} aria-label={car.name} aria-selected={index === 0 ? 'true' : 'false'}></button>
                ))}
              </div>
              <p class="slideshow-status" data-slideshow-status aria-live="polite">1 de {cars.length}</p>
            </div>
          </div>
        )}
        {(catalog.note || catalog.noteLinkLabel) && (
          <div class="container">
            <p class="catalog-note reveal">
              {catalog.note}{' '}
              {catalog.noteLinkLabel && catalog.noteLinkHref && (
                <a href={catalog.noteLinkHref}>{catalog.noteLinkLabel}</a>
              )}
              .
            </p>
          </div>
        )}
      </section>

      {(home.testimonials?.featured || testimonialSupporting.length > 0) && (
        <section class="section" id="testimonios" aria-labelledby="testimonials-title">
          <div class="container">
            {home.testimonials?.intro?.eyebrow && <p class="section-eyebrow reveal">{home.testimonials.intro.eyebrow}</p>}
            {home.testimonials?.intro?.title && <h2 id="testimonials-title" class="reveal">{home.testimonials.intro.title}</h2>}
            <div class="testimonial-layout">
              {home.testimonials?.featured && (
                <article class="testimonial-feature reveal">
                  <span class="quote-mark" aria-hidden="true">“</span>
                  <div class="stars" aria-label={`${home.testimonials.featured.rating ?? 5} de 5 estrellas`}>
                    <span aria-hidden="true">{starsFor(home.testimonials.featured.rating)}</span>
                  </div>
                  <p>“{home.testimonials.featured.quote}”</p>
                  <span class="testimonial-author">
                    {home.testimonials.featured.author}
                    {home.testimonials.featured.dateLabel && ` · ${home.testimonials.featured.dateLabel}`}
                  </span>
                </article>
              )}
              {testimonialSupporting.length > 0 && (
                <div class="testimonial-support">
                  {testimonialSupporting.map((item) => (
                    <article class="testimonial-card reveal">
                      <div class="stars" aria-label={`${item.rating ?? 5} de 5 estrellas`}>
                        <span aria-hidden="true">{starsFor(item.rating)}</span>
                      </div>
                      <p>“{item.quote}”</p>
                      <span class="testimonial-author">{item.author}</span>
                    </article>
                  ))}
                </div>
              )}
            </div>
          </div>
        </section>
      )}

      {faqItems.length > 0 && (
        <section class="section section-alt" id="faq" aria-labelledby="faq-title">
          <div class="container faq-layout">
            <div class="faq-intro reveal">
              {home.faq?.intro?.eyebrow && <p class="section-eyebrow">{home.faq.intro.eyebrow}</p>}
              {home.faq?.intro?.title && <h2 id="faq-title">{home.faq.intro.title}</h2>}
              {home.faq?.intro?.lead && <p>{home.faq.intro.lead}</p>}
              {home.faq?.sidebarLink?.label && (
                <a class="text-link" href={resolveHref(home.faq.sidebarLink)}>
                  {home.faq.sidebarLink.label} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
            <ol class="faq-list reveal">
              {faqItems.map((item) => (
                <li class="faq-item">
                  <details open={item.defaultOpen}>
                    <summary><span>{item.question}</span></summary>
                    <div class="faq-content">
                      {item.answerParagraphs?.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>
                  </details>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )}

      <section class="section contact-section" id="contacto" aria-labelledby="contact-title">
        <div class="container">
          <div class="contact-heading reveal">
            <div class="contact-heading-title">
              {contactTitleLines.length > 0 && (
                <h2 id="contact-title">
                  {contactTitleLines.map((line, index) => (
                    <>
                      {index > 0 && <br />}
                      {line}
                    </>
                  ))}
                </h2>
              )}
            </div>
            <div class="contact-heading-copy">
              {home.contact?.eyebrow && <p class="section-eyebrow">{home.contact.eyebrow}</p>}
              {home.contact?.lead && <p class="contact-heading-lead">{home.contact.lead}</p>}
            </div>
          </div>
          {contactCards.length > 0 && (
            <div class="contact-cards">
              {contactCards.map((card) => (
                <article class="contact-card reveal">
                  {card.number && <span class="contact-card-number">{card.number}</span>}
                  {card.title && <h3>{card.title}</h3>}
                  {card.body && <p>{card.body}</p>}
                  {card.linkLabel && card.linkHref && (
                    <a class="contact-card-link" href={resolveHref({ href: card.linkHref, label: card.linkLabel })}>
                      {card.linkLabel} <span aria-hidden="true">↗</span>
                    </a>
                  )}
                  {card.showHours && (
                    <div class="contact-card-details">
                      {hours.map((hour) => (
                        <span>{hour.label}: {hour.opening} - {hour.closing}</span>
                      ))}
                    </div>
                  )}
                  {card.showContactChannels && (
                    <div class="contact-card-details">
                      {contact.phone && (
                        <a class="contact-detail-link" href={`tel:${contact.phone}`} aria-label={`Llamar al ${contact.phone}`}>
                          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                          <span>{contact.phone}</span>
                        </a>
                      )}
                      {contact.email && (
                        <a class="contact-detail-link" href={`mailto:${contact.email}`} aria-label={`Enviar correo a ${contact.email}`}>
                          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
                          <span>{contact.email}</span>
                        </a>
                      )}
                      {settings.socialLinks?.instagram && home.contact?.instagramHandle && (
                        <a class="contact-detail-link" href={settings.socialLinks.instagram} target="_blank" rel="noopener" aria-label="Visitar el perfil de Instagram de Autos La 15">
                          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
                          <span>{home.contact.instagramHandle}</span>
                        </a>
                      )}
                    </div>
                  )}
                </article>
              ))}
            </div>
          )}
          <div class="contact-actions reveal">
            <div class="contact-location">
              <span class="contact-icon" aria-hidden="true">⌖</span>
              <span>
                <strong>{home.contact?.locationHeading ?? 'Dónde encontrarnos'}</strong><br />
                {locations.map((location, index) => (
                  <span>{location.address}{index < locations.length - 1 ? ' · ' : ''}</span>
                ))}
              </span>
            </div>
            <a class="btn btn-whatsapp contact-cta" href={whatsappHref(generalMessage)} target="_blank" rel="noopener">
              {home.contact?.whatsappCtaLabel ?? 'Hablar por WhatsApp'}
            </a>
          </div>
          {mapSrc && (
            <div class="contact-map reveal">
              <iframe src={mapSrc} width="100%" height="100%" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`Mapa de ubicación de ${brandName} en ${firstLocation?.city}`}></iframe>
            </div>
          )}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-lockup">
          <a href="#top" class="brand">
            <img src={logoSrc} alt={logoAlt} class="brand-logo" width="40" height="40" />
            <span class="brand-text"><strong>{brandName}</strong></span>
          </a>
          <p>{tagline}</p>
        </div>
        <nav class="footer-nav" aria-label="Navegación del pie de página">
          {footerLinks.map((link) => (
            <a href={resolveHref(link)}>{link.label}</a>
          ))}
        </nav>
        <div class="footer-actions">
          <a class="footer-action" href={whatsappHref(generalMessage)} target="_blank" rel="noopener">
            {settings.footer?.whatsappActionLabel ?? 'Hablar por WhatsApp'} <span aria-hidden="true">↗</span>
          </a>
          {settings.socialLinks?.instagram && (
            <a class="footer-action footer-action-instagram" href={settings.socialLinks.instagram} target="_blank" rel="noopener" aria-label="Visitar el perfil de Instagram de Autos La 15">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
              <span>{settings.footer?.instagramActionLabel ?? 'Ver Instagram'}</span>
            </a>
          )}
        </div>
        <p class="footer-copy">{copyrightText}</p>
      </div>
    </footer>

    <a href={whatsappHref(generalMessage)} class="whatsapp-fab" id="whatsapp-fab" target="_blank" rel="noopener" aria-label={whatsappFabLabel}>
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.868-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.226 1.36.194 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.5 3.657 1.451 5.24L2 22l4.897-1.416A9.945 9.945 0 0 0 12.001 22C17.523 22 22 17.522 22 12S17.523 2 12.001 2zm0 18.062a8.012 8.012 0 0 1-4.088-1.118l-.293-.175-2.902.839.848-2.827-.19-.29A8.06 8.06 0 0 1 3.938 12c0-4.446 3.617-8.062 8.063-8.062S20.063 7.554 20.063 12 16.447 20.062 12.001 20.062z"/></svg>
    </a>

    <script src="../scripts/homepage.js"></script>
  </body>
</html>
