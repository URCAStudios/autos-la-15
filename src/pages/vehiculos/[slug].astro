---
import { sanityClient } from 'sanity:client';
import { createSanityImageBuilder, type SanityImage } from '../../lib/sanityImage';
import { assignSlugs, descriptionFacts, statusLabel } from '../../lib/vehicles';
import { resolveVehiclePageCopy } from '../../lib/vehiclePageCopy';
import '../../styles/global.css';
import '../../styles/vehicle.css';

type Link = { label?: string; href?: string; openInNewTab?: boolean };
type Location = { city?: string; address?: string; mapUrl?: string };
type Hour = { label?: string; opening?: string; closing?: string };
type SiteSettings = {
  identity?: { brandName?: string; tagline?: string; logo?: SanityImage };
  contact?: { phone?: string; whatsapp?: string; email?: string };
  hours?: Hour[];
  locations?: Location[];
  socialLinks?: { instagram?: string };
  navigation?: { mainLinks?: Link[]; whatsappButtonLabel?: string };
  footer?: {
    links?: Link[];
    whatsappActionLabel?: string;
    instagramActionLabel?: string;
    copyright?: string;
  };
  messaging?: { defaultWhatsappMessage?: string };
  seo?: { metaDescription?: string };
};

type CarRecord = {
  _id: string;
  name: string;
  title?: string;
  year: number;
  price: number;
  description?: string;
  image?: SanityImage;
  images?: SanityImage[];
  status: string;
  featured?: boolean;
  badge?: string;
  whatsappMessage?: string;
  model3d?: { asset?: { url?: string } };
};

export async function getStaticPaths() {
  const imageFields = `"asset": asset, alt, crop, hotspot`;
  const cars = assignSlugs(
    await sanityClient.fetch<CarRecord[]>(`*[_type == "car" && status in ["available", "reserved"]]
      | order(coalesce(order, 9999) asc, featured desc, _createdAt asc, _id asc){
        _id, name, title, year, price, description,
        image{..., ${imageFields}},
        images[]{..., ${imageFields}},
        status, featured, badge, whatsappMessage,
        model3d{ asset->{ url } }
      }`),
  );
  return cars.map((car) => ({
    params: { slug: car.slug },
    props: { car, cars },
  }));
}

const { car, cars } = Astro.props;
const imageFields = `"asset": asset, alt, crop, hotspot`;
const [settingsDoc, vehiclePageDoc] = await Promise.all([
  sanityClient.fetch<SiteSettings | null>(`*[_type == "siteSettings"][0]{
    identity{ brandName, tagline, logo{..., ${imageFields}} },
    contact, hours, locations, socialLinks,
    navigation, footer, messaging, seo
  }`),
  sanityClient.fetch<Parameters<typeof resolveVehiclePageCopy>[0]>(`*[_id == "vehiclePage"][0]`),
]);
const settings = settingsDoc ?? {};
const copy = resolveVehiclePageCopy(vehiclePageDoc);

const config = sanityClient.config();
if (!config.projectId || !config.dataset) throw new Error('Sanity project configuration is required to build image URLs.');
const images = createSanityImageBuilder(config.projectId, config.dataset);

const brandName = settings.identity?.brandName ?? 'AUTOS LA 15';
const tagline = settings.identity?.tagline ?? 'Compra con claridad. Vende con confianza.';
const contact = settings.contact ?? {};
const locations = settings.locations ?? [];
const hours = settings.hours ?? [];
const firstLocation = locations[0];
const whatsappNumber = (contact.whatsapp || contact.phone || '').replace(/[^\d]/g, '');
const generalMessage = settings.messaging?.defaultWhatsappMessage ?? 'Hola AUTOS LA 15, quiero más información';
const whatsappHref = (message: string) =>
  whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}` : '/#contacto';
const pageHref = (href?: string) => {
  const value = href?.trim();
  if (!value || value === 'whatsapp') return whatsappHref(generalMessage);
  if (value.startsWith('#')) return `/${value}`;
  return value;
};
const linkTarget = (link?: Link) => (link?.openInNewTab ? '_blank' : undefined);
const linkRel = (link?: Link) => (link?.openInNewTab ? 'noopener' : undefined);
const fillTemplate = (template: string, vars: Record<string, string>) =>
  template.replace(/\{(\w+)\}/g, (_, key: string) => vars[key] ?? '');

const formatPrice = (price: number) =>
  new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(price);

const logoSrc = images.url(settings.identity?.logo, { width: 128, height: 128, fit: 'crop' }) || '/assets/img/logo.png';
const logoAlt = settings.identity?.logo?.alt ?? `Logo de ${brandName}`;
const navLinks = settings.navigation?.mainLinks ?? [];
const footerLinks = settings.footer?.links ?? [];
const copyrightText = fillTemplate(settings.footer?.copyright ?? '© {year} {brand}. Todos los derechos reservados.', {
  year: String(new Date().getFullYear()),
  brand: brandName,
});

const sourceImages = car.images?.length ? car.images : car.image ? [car.image] : [];
const photos = sourceImages
  .map((image, index) => ({
    src: images.url(image, { width: 1600 }),
    thumb: images.url(image, { width: 240 }),
    alt: image.alt?.trim() || `${car.name}, foto ${index + 1}`,
  }))
  .filter((photo) => photo.src);
const hasGallery = photos.length > 1;
const facts = descriptionFacts(car.description);
const related = cars.filter((item) => item.slug !== car.slug).slice(0, 3);
const modelUrl = car.model3d?.asset?.url;
const consultMessage = car.whatsappMessage?.trim()
  || `Hola Autos La 15, me interesa el ${car.name} (${formatPrice(car.price)}). ¿Me comparten más información?`;
const consultHref = whatsappHref(consultMessage);
const city = firstLocation?.city?.trim();
const siteUrl = import.meta.env.PUBLIC_SITE_URL?.trim();
const canonicalUrl = siteUrl ? new URL(`/vehiculos/${car.slug}`, siteUrl).toString() : undefined;
const description = car.description?.trim()
  || `${car.name} por ${formatPrice(car.price)}. Disponible en ${brandName}.`;
const rows: { label: string; value: string; href?: string }[] = [
  { label: copy.recordLabels.name, value: car.name },
  { label: copy.recordLabels.year, value: String(car.year) },
  { label: copy.recordLabels.price, value: formatPrice(car.price) },
  { label: copy.recordLabels.status, value: statusLabel(car.status, copy.statusLabels) },
];
if (car.badge?.trim()) rows.push({ label: copy.recordLabels.badge, value: car.badge.trim() });
if (car.featured) rows.push({ label: copy.recordLabels.featured, value: copy.featuredValue });
rows.push({ label: copy.recordLabels.photos, value: String(photos.length) });
rows.push(modelUrl
  ? { label: copy.recordLabels.model3d, value: copy.modelIncluded, href: modelUrl }
  : { label: copy.recordLabels.model3d, value: copy.modelMissing });
const visitLead = city ? fillTemplate(copy.visitLead, { vehicle: car.name, city }) : '';
const mapLabel = fillTemplate(city ? copy.mapLink : copy.mapLinkWithoutCity, { city: city ?? '' });

const hourLine = (hour: Hour) => {
  const line = hour.opening && hour.closing ? `${hour.label}, ${hour.opening} a ${hour.closing}` : (hour.label ?? '');
  const trimmed = line.trim().replace(/\.+$/, '');
  return trimmed ? `${trimmed}.` : '';
};

const relatedCard = (item: (typeof cars)[number]) => {
  const photo = item.images?.[0] ?? item.image;
  return {
    ...item,
    src: images.url(photo, { width: 800 }),
    alt: photo?.alt?.trim() || item.name,
    price: formatPrice(item.price),
  };
};
const relatedCards = related.map(relatedCard).filter((item) => item.src);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Car',
  name: car.name,
  description,
  vehicleModelDate: String(car.year),
  image: photos[0]?.src,
  offers: {
    '@type': 'Offer',
    price: car.price,
    priceCurrency: 'USD',
    availability: car.status === 'reserved' ? 'https://schema.org/LimitedAvailability' : 'https://schema.org/InStock',
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${car.name} | ${brandName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {photos[0] && <meta property="og:image" content={photos[0].src} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" href={logoSrc} />
    <title>{car.name} | {brandName}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body class="vehicle-page">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label={`${brandName}, inicio`}>
          <img src={logoSrc} alt={logoAlt} class="brand-logo" width="40" height="40" />
          <span class="brand-text"><strong>{brandName}</strong><small>{tagline}</small></span>
        </a>
        <nav class="main-nav" id="main-nav" aria-label="Navegación principal">
          {navLinks.map((link) => (
            <a href={pageHref(link.href)} target={linkTarget(link)} rel={linkRel(link)}>{link.label}</a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="btn btn-whatsapp" href={consultHref} target="_blank" rel="noopener" aria-label={settings.navigation?.whatsappButtonLabel ?? 'Hablar por WhatsApp'}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.868-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.226 1.36.194 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.5 3.657 1.451 5.24L2 22l4.897-1.416A9.945 9.945 0 0 0 12.001 22C17.523 22 22 17.522 22 12S17.523 2 12.001 2zm0 18.062a8.012 8.012 0 0 1-4.088-1.118l-.293-.175-2.902.839.848-2.827-.19-.29A8.06 8.06 0 0 1 3.938 12c0-4.446 3.617-8.062 8.063-8.062S20.063 7.554 20.063 12 16.447 20.062 12.001 20.062z"/></svg>
            <span>{settings.navigation?.whatsappButtonLabel ?? 'Hablar por WhatsApp'}</span>
          </a>
          <button class="nav-toggle" id="nav-toggle" type="button" aria-label="Abrir navegación" aria-expanded="false" aria-controls="main-nav">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content">
      <article class="container">
        <nav class="crumbs" aria-label="Migas">
          <a href="/#catalogo">{copy.breadcrumbLabel}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{car.name}</span>
        </nav>
        <div class="dossier">
          {photos.length > 0 && (
            <div class="gallery" data-vehicle-gallery>
              <div class="stage">
                <button class="stage-open" type="button" data-stage-open aria-label={copy.enlargePhoto}>
                  <img data-stage-current src={photos[0].src} alt={photos[0].alt} width="1600" height="1600" />
                </button>
                {hasGallery && <p class="stage-count" data-stage-status>1 de {photos.length}</p>}
                {hasGallery && (
                  <>
                    <button class="stage-arrow stage-arrow-prev" type="button" data-stage-prev aria-label={copy.previousPhoto}>‹</button>
                    <button class="stage-arrow stage-arrow-next" type="button" data-stage-next aria-label={copy.nextPhoto}>›</button>
                  </>
                )}
              </div>
              {hasGallery && (
                <ul class="film" role="tablist" aria-label={`Fotos de ${car.name}`}>
                  {photos.map((photo, index) => (
                    <li>
                      <button class:list={[{ 'is-active': index === 0 }]} type="button" role="tab" data-stage-thumb={index} data-alt={photo.alt} aria-label={`${fillTemplate(copy.photoLabel, { number: String(index + 1) })}: ${photo.alt}`} aria-selected={index === 0 ? 'true' : 'false'}>
                        <img src={photo.thumb} alt="" width="240" height="240" />
                      </button>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}
          <div class="sheet">
            <div class="chip-row">
              <span class="chip">{statusLabel(car.status, copy.statusLabels)}</span>
              {car.badge?.trim() && <span class="chip chip-badge">{car.badge.trim()}</span>}
            </div>
            <h1 tabindex="-1">{car.name}</h1>
            <p class="price">{formatPrice(car.price)}</p>
            <div class="actions">
              <a class="btn btn-primary" href={consultHref} target="_blank" rel="noopener">{copy.primaryButton}</a>
              <a class="btn btn-ghost" href="#visita">{copy.secondaryButton}</a>
            </div>
            {facts.length > 0 && (
              <>
                <h2 class="visually-hidden">{copy.factsTitle}</h2>
                <dl class="facts">
                  {facts.map((fact) => (
                    <div>
                      <dt>{copy.factLabels[fact.key]}</dt>
                      <dd>{fact.value}</dd>
                    </div>
                  ))}
                </dl>
              </>
            )}
          </div>
        </div>
        <section class="detail-panels" aria-label="Descripción y datos del anuncio">
          <div class="detail-panels-grid">
            {car.description?.trim() && (
              <section class="detail-panel story-panel" aria-labelledby="description-title">
                <h2 id="description-title">{copy.descriptionTitle}</h2>
                <p>{car.description.trim()}</p>
              </section>
            )}
            <section class="detail-panel record-panel" aria-labelledby="record-title">
              <h2 id="record-title">{copy.recordTitle}</h2>
              <dl class="record-table">
                {rows.map((row) => (
                  <div class="record-row">
                    <dt>{row.label}</dt>
                    <dd>{row.href ? <a href={row.href} target="_blank" rel="noopener">{row.value}</a> : row.value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          </div>
        </section>
      </article>

      <section class="visit" id="visita" aria-labelledby="visit-title">
        <div class="container visit-grid">
          <div>
            <h2 id="visit-title">{copy.visitTitle}</h2>
            {visitLead && <p>{visitLead}</p>}
            {hours.map((hour) => (
              hourLine(hour) && <p>{hourLine(hour)}</p>
            ))}
          </div>
          <div class="visit-places">
            {locations.map((location) => (
              <p>
                {location.city && <strong>{location.city}</strong>}
                {location.city && <br />}
                {location.address}
              </p>
            ))}
            {firstLocation?.mapUrl && (
              <p><a href={firstLocation.mapUrl} target="_blank" rel="noopener">{mapLabel}</a></p>
            )}
            {contact.email && <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>}
          </div>
        </div>
      </section>

      {relatedCards.length > 0 && (
        <section class="lote" id="lote" aria-labelledby="lote-title">
          <div class="container">
            <h2 id="lote-title">{copy.relatedTitle}</h2>
            <ul class="lote-list">
              {relatedCards.map((item) => (
                <li>
                  <a class="lote-card" href={`/vehiculos/${item.slug}`}>
                    <img src={item.src} alt={item.alt} width="800" height="800" />
                    <span class="lote-copy">
                      {item.badge?.trim() && <span class="lote-mark">{item.badge.trim()}</span>}
                      <strong>{item.name}</strong>
                      <span>{item.price}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-lockup">
          <a href="/" class="brand">
            <img src={logoSrc} alt={logoAlt} class="brand-logo" width="40" height="40" />
            <span class="brand-text"><strong>{brandName}</strong></span>
          </a>
          <p>{tagline}</p>
        </div>
        <nav class="footer-nav" aria-label="Navegación del pie de página">
          {footerLinks.map((link) => (
            <a href={pageHref(link.href)} target={linkTarget(link)} rel={linkRel(link)}>{link.label}</a>
          ))}
        </nav>
        <div class="footer-actions">
          <a class="footer-action" href={whatsappHref(generalMessage)} target="_blank" rel="noopener">
            {settings.footer?.whatsappActionLabel ?? 'Hablar por WhatsApp'} <span aria-hidden="true">↗</span>
          </a>
          {settings.socialLinks?.instagram && (
            <a class="footer-action footer-action-instagram" href={settings.socialLinks.instagram} target="_blank" rel="noopener" aria-label="Visitar el perfil de Instagram de Autos La 15">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
              <span>{settings.footer?.instagramActionLabel ?? 'Ver Instagram'}</span>
            </a>
          )}
        </div>
        <p class="footer-copy">{copyrightText}</p>
      </div>
    </footer>

    <div class="dock" id="dock">
      <strong>{formatPrice(car.price)}</strong>
      <a class="btn btn-primary" href={consultHref} target="_blank" rel="noopener">{copy.primaryButton}</a>
    </div>

    <dialog class="lightbox" id="lightbox" aria-label="Foto ampliada">
      <div class="lightbox-bar">
        <p id="lightbox-status"></p>
        <button type="button" id="lightbox-close">{copy.closePhoto}</button>
      </div>
      <img id="lightbox-img" alt="" width="1600" height="1600" />
      <div class="lightbox-nav">
        <button type="button" id="lightbox-prev">{copy.previousPhoto}</button>
        <button type="button" id="lightbox-next">{copy.nextPhoto}</button>
      </div>
    </dialog>

    <script src="../../scripts/vehicle-page.js"></script>
  </body>
</html>
